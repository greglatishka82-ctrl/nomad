# ---- runtime ----
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
DATA_DIR=./data
TZ=Asia/Almaty
PUBLIC_BASE_URL=http://127.0.0.1:3000
DISABLE_BOTS=1

# ---- admin ----
ADMIN_LOGIN=admin
# Задайте свой пароль перед первым запуском.
ADMIN_PASSWORD=change-me
# Случайная строка для подписи сессий.
SESSION_SECRET=change-me-to-a-random-64-character-secret

# ---- telegram ----
# Токены выдаёт @BotFather. Не коммитьте реальные значения.
CLIENT_BOT_TOKEN=123456789:replace-with-client-bot-token
MASTER_BOT_TOKEN=123456789:replace-with-master-bot-token
CLIENT_BOT_USERNAME=kranof_bot

# ---- company defaults ----
COMPANY_PHONE=
COMPANY_WHATSAPP=
COMPANY_EMAIL=
COMPANY_ADDRESS=Павлодар
