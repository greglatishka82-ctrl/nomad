# Токен бота автопостинга (Пост-БОТ)
AUTOPOST_BOT_TOKEN=

# Канал, куда публикуются посты
AUTOPOST_CHANNEL=@greentime_pvl

# Telegram chat_id владельца. 0 — не задан, бот покажет id по команде /start
AUTOPOST_OWNER_ID=0

AUTOPOST_TIMEZONE=Asia/Almaty

# PostgreSQL GREENTIME (отдельные таблицы autopost_*)
POSTGRES_DSN=postgresql://nomad:ПАРОЛЬ@greentime-db-1:5432/nomad_test

# Папки внутри контейнера
INBOX_DIR=/data/inbox
MEDIA_DIR=/data/media
PROCESSED_DIR=/data/processed

# Публичная раздача картинок для Instagram (общий том с сайтом)
PUBLIC_MEDIA_DIR=/public/ig
PUBLIC_MEDIA_URL=https://greentime.57-129-153-111.sslip.io/static/ig

# Публикация в Instagram через Buffer
IG_ENABLED=true
BUFFER_API_KEY=
BUFFER_CHANNEL_ID=

# Расписание (Asia/Almaty): будни 10:00, выходные 12:00, превью за час
PREVIEW_LEAD_MINUTES=60
WEEKDAY_PUBLISH_HOUR=10
WEEKEND_PUBLISH_HOUR=12
